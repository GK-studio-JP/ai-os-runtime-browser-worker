{
  "schema": "ai-os-process:v1",
  "id": "PROC-RUNTIME-BROWSER-WORKER",
  "name": "runtime-browser-worker",
  "repository": "GK-studio-JP/ai-os-runtime-browser-worker",
  "responsibility": [
    "browser chat worker bootstrap",
    "canonical bulletin-board task discovery",
    "fresh canonical replay before claim and completion",
    "browser-agent execution lifecycle",
    "protocol-compliant progress and result reporting"
  ],
  "excludes": [
    "task scheduling policy",
    "capability grants",
    "inventing task priority",
    "treating chat or browser state as canonical",
    "embedding the full task body as worker bootstrap"
  ],
  "consumes": [
    "explicit scheduler routing or task Issue pointer",
    "GK-studio-JP/ai-bulletin-board Issue/comment history",
    "protocol/GITHUB_PROTOCOL.md",
    "browser-agent/BROWSER_AGENT_INSTRUCTIONS.md"
  ],
  "provides": [
    "CLAIM/HEARTBEAT/PROGRESS/HANDOFF/RELEASE/RESULT protocol events",
    "immutable implementation artifact references",
    "resumable browser-worker checkpoints"
  ]
}
